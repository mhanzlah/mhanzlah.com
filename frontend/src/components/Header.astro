---
import "../styles/header.css";

const currentPath = Astro.url.pathname;
---

<header class="header">
  <div class="container">
    <nav class="header__nav" aria-label="Navigation">
      <div class="header__brand">
        <a href="/">
          <span class="header__name">Muhammad Hanzla</span>
        </a>
        <span class="header__role">Full-Stack Developer</span>
      </div>

      <ul class="header__links">
        <li>
          <a href="/" aria-current={currentPath === "/" ? "page" : undefined}
            >home</a
          >
        </li>
        <li>
          <a
            href="/work"
            aria-current={currentPath.startsWith("/work") ? "page" : undefined}
            >work</a
          >
        </li>
        <li>
          <a
            href="/contact"
            aria-current={currentPath.startsWith("/contact")
              ? "page"
              : undefined}>contact</a
          >
        </li>
      </ul>
    </nav>
  </div>
</header>
